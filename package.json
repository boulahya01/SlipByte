{
  "name": "slipbyte",
  "version": "0.1.0",
  "description": "TypeScript-first toolkit for building and printing thermal receipts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "check:package": "npm run build && node scripts/verify-package.mjs",
    "release:check": "npm run check && npm run check:package",
    "prepublishOnly": "npm run release:check",
    "conformance:unicode": "npm run build && node scripts/unicode-raster-conformance.mjs"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": ">=22 <27",
    "typescript": ">=5.5 <8"
  },
  "keywords": [
    "thermal-printer",
    "receipt",
    "escpos",
    "esc-pos",
    "pos",
    "point-of-sale",
    "printer",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boulahya01/SlipByte.git"
  },
  "bugs": {
    "url": "https://github.com/boulahya01/SlipByte/issues"
  },
  "homepage": "https://github.com/boulahya01/SlipByte#readme"
}
